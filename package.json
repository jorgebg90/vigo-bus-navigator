{
  "name": "vigo-bus-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --mode development",
    "build": "tsx scripts/generate-openapi-docs.ts && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "lint:openapi": "spectral lint specs/002-realtime-bus-api/contracts/realtime-arrivals.openapi.yaml specs/003-improve-frontend-design/contracts/realtime-api-v4.openapi.yaml specs/004-vigo-jsp-transit-api/contracts/municipal-transit-v5.openapi.yaml",
    "validate:municipal-api-contract": "tsx scripts/validate-municipal-api-contract.ts",
    "validate:production-artifact": "tsx scripts/validate-production-artifact.ts",
    "smoke:municipal-live": "tsx scripts/smoke-municipal-live.ts",
    "size": "size-limit && tsx scripts/check-payload-budget.ts",
    "snapshot:generate": "tsx scripts/snapshot/generate.ts",
    "catalog:generate": "tsx scripts/catalog/generate.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "maplibre-gl": "^5.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@size-limit/file": "^11.2.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "happy-dom": "^17.6.3",
    "lighthouse": "^12.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  }
}
