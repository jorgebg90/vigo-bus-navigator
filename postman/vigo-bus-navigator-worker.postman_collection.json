{
  "info": {
    "name": "Vigo Bus Navigator - Municipal JSP",
    "description": "Direct requests to the public Vigo municipal JSP; this collection does not call the retired Worker API. Eight general actions (including the TRANSPORTE_PARADAS online stop catalog) plus the online line catalog (schedule by public line code, trip stops by trip_id, geometry by shape_id) are enabled for every line in local-live and production, mirroring the official Vigo app. Line-stop detail remains limited to stop 2789 / line A. Postman does not validate browser CORS behavior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "endpoint",
      "value": "https://datos.vigo.org/vci_api_app/api2.jsp",
      "type": "string"
    },
    {
      "key": "stopId",
      "value": "2789",
      "type": "string"
    },
    {
      "key": "vitrasaId",
      "value": "90",
      "type": "string"
    },
    {
      "key": "lineCode",
      "value": "A",
      "type": "string"
    },
    {
      "key": "dayCode",
      "value": "1",
      "type": "string"
    },
    {
      "key": "shapeId",
      "value": "Route_1005",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "A  02LP000_008002_4",
      "type": "string"
    },
    {
      "key": "min",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Supported actions - enabled in the application",
      "description": "These seven source actions are enabled in local-live and production profiles. Use municipal stop IDs and Vitrasa IDs only for their documented, distinct purposes.",
      "item": [
        {
          "name": "Lines catalog (Spanish / English locale)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEAS_ES"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a JSON line catalog', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lines catalog (Galician locale)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEAS_GA"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a JSON line catalog', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Line service metadata (Spanish)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEAS_SERVICIOS_ES"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns JSON service metadata', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Line service metadata (Galician)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEAS_SERVICIOS_GA"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns JSON service metadata', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Stop detail by Vitrasa ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_PARADA_ID&id={{vitrasaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns JSON stop detail', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lines serving a municipal stop",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEAS_PARADA&id={{stopId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns JSON serving lines', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Online stop catalog (all stops)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Official-app stop list used for stop search. stop_id is the municipal code, id is the Vitrasa ID, lineas lists public line codes.",
            "url": "{{endpoint}}?tipo=TRANSPORTE_PARADAS"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the online stop catalog', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "  pm.expect(pm.response.json().length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Arrivals by Vitrasa ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE-ESTIMACION-PARADA&id={{vitrasaId}}&ttl=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns JSON arrivals payload', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Online line catalog - every line",
      "description": "Mirrors the official Vigo app: schedules by public line code, then trip stops and geometry from the trip_id/shape_id of the returned rows. Enabled for every line in local-live and production by product-owner direction on 2026-10-28. Line-stop detail remains limited to stop 2789 / line A.",
      "item": [
        {
          "name": "Schedule by public line code (dayCode 1 weekday, 6 Saturday, 0 Sunday/holiday)",
          "request": {
            "method": "GET",
            "description": "Use the public line code (for example A, C1, 4C) as id. The app keeps every returned row like the official app; trip_id prefixes are internal block codes, not line identity. Departure times are separated by ', '.",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEA_HORARIOS_EXTEND&id={{lineCode}}&dia={{dayCode}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns schedule rows', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Route geometry by schedule shape_id",
          "request": {
            "method": "GET",
            "description": "Use a shape_id from a schedule row. The app draws the shape of the first representative trip.",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEA_GEOJSON&id={{shapeId}}"
          }
        },
        {
          "name": "Trip stops by schedule trip_id",
          "request": {
            "method": "GET",
            "description": "Use a trip_id from a schedule row. The app requests one representative trip per direction (active first, then most departures).",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_PARADAS_TRIP&id={{tripId}}"
          }
        },
        {
          "name": "Line-stop details - municipal stop 2789, line A",
          "request": {
            "method": "GET",
            "description": "Stakeholder reports min is measured in minutes. The app sends only fixed min=0 and permits only stop_id=2789,linea=A in production and local-live; it does not expose a configurable threshold.",
            "header": [],
            "url": "{{endpoint}}?tipo=TRANSPORTE_LINEA_INFO_PARADA&stop_id={{stopId}}&linea={{lineCode}}&min={{min}}"
          }
        }
      ]
    }
  ]
}
